# Pywal, for procedural theming
exec $HOME/.local/bin/uppy.sh $HOME/pape
# Called from a script to automatically generate a new colorscheme
# if wallpaper has changed.

# Modifier keys (both win/cmd and alt, for more options)
set $cmd Mod4
set $alt Mod1

# Program launcher
set $menu "rofi -show drun"
set $menu-alt "rofi -show run"

# Home row direction keys
set $left h
set $down j
set $up k
set $right l

# Terminal emulator
set $term alacritty

### Output configuration
#
# Default wallpaper (more resolutions are available in /usr/share/backgrounds/sway/)
# This is commented in Debian, because the Sway wallpaper files are in a separate
# package `sway-backgrounds`. Installing this package drops a config file to
# /etc/sway/config.d/
# output * bg $HOME/pape fill
output * subpixel rgb
output * scale_filter nearest
#
# Example configuration:
#
#   output HDMI-A-1 resolution 1920x1080 position 1920,0
#
# You can get the names of your outputs by running: swaymsg -t get_outputs

### Idle configuration
#
# Example configuration:
#
# exec swayidle -w \
#          timeout 300 'swaylock -f -c 000000' \
#          timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
#          before-sleep 'swaylock -f -c 000000'
#
# This will lock your screen after 300 seconds of inactivity, then turn off
# your displays after another 300 seconds, and turn your screens back on when
# resumed. It will also lock your screen before your computer goes to sleep.

### Input configuration
#
# Example configuration:
#
#   input "2:14:SynPS/2_Synaptics_TouchPad" {
#       dwt enabled
#       tap enabled
#       natural_scroll enabled
#       middle_emulation enabled
#   }
#
# You can get the names of your inputs by running: swaymsg -t get_inputs
# Read `man 5 sway-input` for more information about this section.

### Key bindings

	##################
	  # # Basic # #
	##################
	
    # Start terminal
    bindsym $cmd+Return exec $term
    bindsym $alt+Ctrl+t exec $term

    # Kill focused window
    bindsym $cmd+q kill
	bindsym button2 kill

    # Start launcher
    bindsym $cmd+d exec $menu
    bindsym $cmd+Shift+d exec $menu-alt

	# Binding that allows you to click and hold to move/resize windows
    floating_modifier $cmd normal

    # Reload the configuration file
    bindsym $cmd+Shift+r reload

	# Lock sway
	bindsym $alt+$cmd+l exec 'swaylock -i $HOME/pape -Fe --font "Terminess Nerd Font Mono" --font-size 12 --ring-color $foreground'

    # Exit sway
    bindsym $cmd+Shift+e exec swaynag -t warning -m "Are you really going to leave me? :(" -B "I'm out" "swaymsg exit"
	
	####################
	  # # Movement # #
	####################
	
    # Move your focus around
    bindsym $cmd+$left focus left
    bindsym $cmd+$down focus down
    bindsym $cmd+$up focus up
    bindsym $cmd+$right focus right
    # Or use $cmd+[up|down|left|right]
    bindsym $cmd+Left focus left
    bindsym $cmd+Down focus down
    bindsym $cmd+Up focus up
    bindsym $cmd+Right focus right

    # Move the focused window with the same, but add Shift
    bindsym $cmd+Shift+$left move left
    bindsym $cmd+Shift+$down move down
    bindsym $cmd+Shift+$up move up
    bindsym $cmd+Shift+$right move right
    # Ditto, with arrow keys
    bindsym $cmd+Shift+Left move left
    bindsym $cmd+Shift+Down move down
    bindsym $cmd+Shift+Up move up
    bindsym $cmd+Shift+Right move right

	######################
	  # # Workspaces # #
	######################
	
    # Switching
    bindsym $cmd+1 workspace number 1:I
    bindsym $cmd+2 workspace number 2:II
    bindsym $cmd+3 workspace number 3:III
    bindsym $cmd+4 workspace number 4:IV
    bindsym $cmd+5 workspace number 5:V
    bindsym $cmd+6 workspace number 6:VI
    bindsym $cmd+7 workspace number 7:VII
    bindsym $cmd+8 workspace number 8:VIII
    bindsym $cmd+9 workspace number 9:IX
    bindsym $cmd+0 workspace number 10:X

    # Moving containers
    bindsym $cmd+Shift+1 move container to workspace number 1:I
    bindsym $cmd+Shift+2 move container to workspace number 2:II
    bindsym $cmd+Shift+3 move container to workspace number 3:III
    bindsym $cmd+Shift+4 move container to workspace number 4:IV
    bindsym $cmd+Shift+5 move container to workspace number 5:V
    bindsym $cmd+Shift+6 move container to workspace number 6:VI
    bindsym $cmd+Shift+7 move container to workspace number 7:VII
    bindsym $cmd+Shift+8 move container to workspace number 8:VIII
    bindsym $cmd+Shift+9 move container to workspace number 9:IX
    bindsym $cmd+Shift+0 move container to workspace number 10:X
	
	##################
	  # # Layout # #
	##################
	
	# Select split mode direction
    bindsym $cmd+Shift+v splith
    bindsym $cmd+v splitv

    # Switch the current container between different layout styles
    bindsym $cmd+s layout stacking
    bindsym $cmd+w layout tabbed
    bindsym $cmd+e layout toggle split

	# Make the focused window fullscreen
    bindsym $cmd+f fullscreen 
	
	# Break free from/lock into grid
    bindsym $cmd+Shift+space floating toggle 

	# Swap focus between the grid and the floating area
    bindsym $cmd+space focus mode_toggle 

	# Move focus to the parent container
    bindsym $cmd+a focus parent 

	# Move focus away from parent
	bindsym $cmd+Shift+a focus child 
    
	# Scratchpad
    bindsym $cmd+Shift+c move scratchpad
	bindsym $cmd+c scratchpad show

	#################
  	  # # Modes # #
	#################

mode "resize" {
    bindsym $down resize grow height 10px
    bindsym $left resize shrink width 10px
    bindsym $right resize grow width 10px
    bindsym $up resize shrink height 10px

	# Same as above, but for arrows
    bindsym Down resize grow height 10px
    bindsym Left resize shrink width 10px
    bindsym Right resize grow width 10px
    bindsym Up resize shrink height 10px

    # Leave mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $cmd+r mode "resize"

mode "open" {
	bindsym t exec $term -e htop; mode "default"
	bindsym f exec $term -e yazi; mode "default"
	bindsym Shift+f exec pcmanfm-qt; mode "default"

	bindsym w exec qutebrowser; mode "default"

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $cmd+Tab mode "open"
	
	########################
	  # # Utility Keys # #
	########################

# Adjust volume
bindsym --locked XF86AudioMute exec pactl set-sink-mute \@DEFAULT_SINK@ toggle
bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume \@DEFAULT_SINK@ -5%
bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume \@DEFAULT_SINK@ +5%
bindsym --locked XF86AudioMicMute exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle #Toggle mic
bindsym --locked XF86AudioPlay exec playerctl play-pause #Pause/Play

# Adjust brightness via brightnessctl
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+

# Special key to take a screenshot with grim
bindsym Print exec grim

	###################
	  # # Styling # #
	###################

font "Terminess Nerd Font Mono" 9
include $HOME/.cache/wal/colors-sway

# class                 border    backgr.   text      indicator child_border
client.focused          $color10   $color2   $foreground   $color2   $color10
client.focused_inactive $color5   $color0   $color7   $color3   $color5
client.focused_tab_title $color9   $color9   $foreground   $color2   $color9
client.unfocused        $color0   $color0   $color5   $color0   $color3
client.urgent           $color15  $color15  $color7   $color15  $color15
client.placeholder      $color3   $color3   $color7   $color3   $color3
	
default_border pixel 3
default_floating_border pixel 3
titlebar_border_thickness 3
title_align center
for_window [floating] border pixel 3
gaps inner 6
smart_gaps on
smart_borders no_gaps

bar {
	bindsym button2 kill

	icon_theme "WhiteSur-nord"

	id "bar-lite"
	separator_symbol " • "
	position top
	status_command i3status
	status_edge_padding 6
	strip_workspace_numbers yes

	colors {
		background $color0
		statusline $color14
		separator $color6
		focused_workspace $color11 $color11 $color0
		inactive_workspace $color1 $color1 $color8
		urgent_workspace $color0 #dd3322 $color0
		binding_mode $color14 $color0 $color14
	}
}

	##########################
	  # # Miscellaneous # #
	##########################

bindsym $alt+$cmd+equal opacity plus 0.05
bindsym $alt+$cmd+minus opacity minus 0.05
bindsym $alt+$cmd+r opacity 1
bindsym $alt+$cmd+h opacity 0.05

input type:keyboard {
		xkb_layout us,br
		xkb_options grp:rctrl_toggle
		xkb_numlock enabled
	}

focus_follows_mouse no


include window_rules
include per_machine
