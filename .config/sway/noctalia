set $secondary          #cfc5bb
set $tertiary           #c5c8b6
set $error              #ffb4ab
set $surface            #151312
set $on_surface         #e7e1df
set $on_surface_variant #cfc5ba
set $outline            #988f86

## Window Colours
# class                 border    backgr.   text                indicator  child_border
client.focused          $primary  $surface  $on_surface         $primary   $primary
client.focused_inactive $outline  $surface  $on_surface_variant $outline   $outline
