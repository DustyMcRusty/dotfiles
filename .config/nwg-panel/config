[
  {
    "name": "panel-top",
    "output": "HDMI-A-1",
    "layer": "bottom",
    "position": "top",
    "controls": "right",
    "width": 1024,
    "height": 16,
    "homogeneous": true,
    "margin-top": 0,
    "margin-bottom": 0,
    "padding-horizontal": 0,
    "padding-vertical": 0,
    "spacing": 0,
    "items-padding": 0,
    "icons": "light",
    "css-name": "panel-top",
    "modules-left": [
      "sway-workspaces",
      "sway-mode",
      "scratchpad"
